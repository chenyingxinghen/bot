HOST=0.0.0.0
PORT=7001
COMMAND_START=[""]
COMMAND_SEP=["."]
LOG_LEVEL=INFO
ONEBOT_V11_ACCESS_TOKEN=

# 自建 Web/PWA（与 NoneBot 共用 HOST/PORT；访问地址示例 http://127.0.0.1:7001/bot/）
WEB_ENABLED=false
WEB_PATH=/bot
# 会话令牌签名密钥（启用前必须设置足够长的随机值）；同时替代了旧的“浏览器令牌”
WEB_TOKEN=
# 全局最大账号数：个人 BOT 默认 1（仅允许注册一个账号）。
# 想允许多个独立用户就调大；每台设备仍只能注册一次。
WEB_MAX_ACCOUNTS=1
# 账号存储文件与 Web 实际投递历史（相对路径解析到 bot 根目录）
WEB_ACCOUNTS_FILE=data/web_accounts.json
WEB_HISTORY_DB=data/web_history.db
WEB_STATIC_DIR=core/web/static
# 流式输出：true=逐字显示打字效果（仅 Web 入口，QQ/飞书不受影响）
WEB_STREAM=true

# 飞书企业自建机器人长连接；启用前安装 lark-oapi 并填写应用凭证
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_ID=main

# 聊天模型
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen3-vl:8b
LLM_THINK=false
LLM_TEMPERATURE=0.6
LLM_NUM_PREDICT=192
LLM_ECHO_RETRY_CONTEXT=6
# 完整记录每次 LLM messages 输入和原始输出；可能包含对话隐私，生产环境按需开启
LLM_LOG_FULL_IO=false
LLM_KEEP_ALIVE=30m

# 回复行为
MAX_CONTEXT=20
CONTEXT_TIMEOUT=7200
REPLY_DELAY_MIN=1
REPLY_DELAY_MAX=4
# <=0 表示不按字符切分；生产可按 QQ 实际上限设置较大值
MAX_REPLY_CHARS=0
MAX_REPLY_ACTIONS=3
STREAM_PAUSE=0.4
MAX_BUBBLE_CHARS=200
WORKS_STATE_PATH=data/works_state.json
MODES_STATE_PATH=data/modes_state.json
MAX_IMAGES=4
MAX_IMAGE_BYTES=10485760
BOT_OUTPUT_PREFIX="[BOT_OUTPUT] "
CLONE_PROMPT_PATH=data/modes/clone.txt

# 记忆与向量
# {mode} 会替换为 tavern/clone/writer；不写占位符时程序也会自动插入
MEMORY_DB=data/memory_{mode}.db
EMBEDDING_API_BASE=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT=30
EMBEDDING_NUM_GPU=0
EMBEDDING_KEEP_ALIVE=30m
# 在线长期记忆抽取总开关与模式开关
MEMORY_AUTO_EXTRACT=true
MEMORY_CLONE_AUTO_EXTRACT=false
MEMORY_TAVERN_AUTO_EXTRACT=true
MEMORY_WRITER_AUTO_EXTRACT=true
# clone 如启用则默认 8 轮；酒馆/作家默认 4 轮触发
MEMORY_EXTRACT_MIN_MESSAGES=16
MEMORY_EXTRACT_MIN_PARTNER_MESSAGES=6
MEMORY_EXTRACT_MIN_SEMANTIC_CHARS=160
MEMORY_EXTRACT_MIN_CONFIDENCE=0.75
MEMORY_TAVERN_MIN_MESSAGES=8
MEMORY_TAVERN_MIN_PARTNER_MESSAGES=4
MEMORY_WRITER_MIN_MESSAGES=8
MEMORY_WRITER_MIN_PARTNER_MESSAGES=4

# QQ 富消息互动
QUOTE_HISTORY_SIZE=12
STICKER_ENABLED=true
STICKER_DIR=data/stickers
STICKER_PROMPT_LIMIT=30
POKE_BACK=true
POKE_TEXT_REPLY=true
POKE_COOLDOWN=15

# ── 推理任务队列（性能受限机器建议把 MAX_INFERENCE_WORKERS 设为 1）──
MAX_INFERENCE_WORKERS=2
MAX_PENDING_TASKS=20
COMFYUI_MAX_CONCURRENT_IMAGES=1

# ── 三种模式使用的模型 ──
# 酒馆角色扮演：SillyTavern 风格角色扮演（用你本地实际的 Ollama 标签）
MODE_TAVERN_MODEL=baytout3/gemma-4-e4b-uncensored-hauhaucs-aggressive:q4_k_p
# 人类模仿：视觉模型
MODE_CLONE_MODEL=myclone-vl:latest
# 小说作家：当前生产规格与 tavern 使用同一 gemma 模型
MODE_WRITER_MODEL=baytout3/gemma-4-e4b-uncensored-hauhaucs-aggressive:q4_k_p

# ── 酒馆模式接入真实 SillyTavern（角色卡 / 世界书 / 可选服务端代理）──
SILLYTAVERN_DATA_ROOT=G:/git_proj/SillyTavern/data
SILLYTAVERN_USER=default-user
SILLYTAVERN_DEFAULT_CHARACTER=auto
SILLYTAVERN_USER_NAME=你
# 留空=直连 Ollama（最稳）；设为 SillyTavern 地址可走服务端代理（如 http://127.0.0.1:8000）
SILLYTAVERN_URL=
SILLYTAVERN_SOURCE=openai
SILLYTAVERN_REVERSE_PROXY=http://127.0.0.1:11434/v1
SILLYTAVERN_MODEL=
SILLYTAVERN_API_KEY=

# ── ComfyUI 文生图 ──
COMFYUI_URL=http://127.0.0.1:8188
# 当前 T2I API 工作流；换文件时须同步更新以下节点映射
COMFYUI_WORKFLOW=data/t2i.json
COMFYUI_POSITIVE_NODE=67
COMFYUI_POSITIVE_KEY=text
COMFYUI_NEGATIVE_NODE=71
COMFYUI_NEGATIVE_KEY=text
COMFYUI_SEED_NODE=69
COMFYUI_SEED_KEY=seed
# 通常与 seed 节点相同（KSampler）；steps/cfg/sampler/scheduler/denoise 将写入此节点
COMFYUI_SAMPLER_NODE=69
COMFYUI_SIZE_NODE=68
COMFYUI_WIDTH_KEY=width
COMFYUI_HEIGHT_KEY=height
COMFYUI_OUTPUT_NODE=77
# 若想固定某个检查点，同时配置加载节点、输入键和完整文件名；全部留空则使用 workflow 里的值
COMFYUI_CKPT_NODE=78
COMFYUI_CKPT_KEY=ckpt_name
COMFYUI_CKPT_NAME=nsfwProjectAnime_v20Unchained_fp8.safetensors
COMFYUI_NEGATIVE_PROMPT=
COMFYUI_WIDTH=512
COMFYUI_HEIGHT=768
COMFYUI_STEPS=10
COMFYUI_CFG=2.0
COMFYUI_SAMPLER=euler_ancestral
COMFYUI_SCHEDULER=simple
COMFYUI_DENOISE=1.0
COMFYUI_TIMEOUT=300
COMFYUI_POLL_INTERVAL=1.5
COMFYUI_MAX_IMAGES=4
COMFYUI_OUTPUT_DIR=data/generated